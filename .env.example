# ============ DeepSeek（生成模型）============
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ Embedding（向量化模型，OpenAI 兼容接口）============
# DeepSeek 不提供 Embedding 接口，这里用硅基流动免费的 BGE-M3
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ============ 向量数据库 ============
# local  ：本地 JSON 持久化向量库，开箱即用，适合演示/面试
# qdrant ：Qdrant 向量数据库（需 docker run -p 6333:6333 qdrant/qdrant）
VECTOR_STORE=local
LOCAL_STORE_PATH=data/vector_store.json
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=health_knowledge

# ============ 热点答案缓存 ============
# local：内存实现，开箱即用
# redis：生产实现（需 docker run -d --name redis -p 6379:6379 redis:7-alpine）
ANSWER_CACHE=local
CACHE_THRESHOLD=0.92
CACHE_TTL_MINUTES=1440
CACHE_MAX_SIZE=1000
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ 多轮会话上下文 ============
SESSION_TTL_MINUTES=30
SESSION_MAX_TURNS=5

# ============ 服务 ============
PORT=8080
